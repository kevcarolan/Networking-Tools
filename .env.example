# Copy to .env (Docker) or /etc/netops/netops.env (systemd) and fill in.

# --- Storage ---------------------------------------------------------------
# NETOPS_DATA_DIR=/var/lib/netops
# Keep the credential key OUTSIDE the data folder and back it up separately:
# without it, stored device passwords cannot be decrypted.
NETOPS_CREDENTIAL_KEY_FILE=/etc/netops/credential.key

# --- Web sessions ----------------------------------------------------------
# true when served over HTTPS (behind Caddy/nginx) - recommended
NETOPS_SESSION_HTTPS_ONLY=true
NETOPS_SESSION_MAX_AGE_HOURS=12
# Interactive API docs at /docs; keep off in production
NETOPS_API_DOCS=false

# --- Monitoring (PRTG) -------------------------------------------------------
# Token for the PRTG "HTTP Data Advanced" sensor at /api/monitoring/prtg.
# Generate with:  openssl rand -hex 32     Empty = endpoint switched off.
NETOPS_MONITORING_TOKEN=

# --- Active Directory ------------------------------------------------------
NETOPS_LDAP_URL=ldaps://dc1.corp.local
NETOPS_LDAP_DOMAIN=corp.local
NETOPS_LDAP_BASE_DN=DC=corp,DC=local
NETOPS_LDAP_ADMIN_GROUP=CN=NetOps-Admins,OU=Groups,DC=corp,DC=local
NETOPS_LDAP_VIEWER_GROUP=CN=NetOps-Viewers,OU=Groups,DC=corp,DC=local
# Members may plan and run firmware upgrade jobs (on top of admin or viewer).
# Set this in production. If it is empty, admins can run upgrades.
NETOPS_LDAP_UPGRADER_GROUP=CN=NetOps-Upgraders,OU=Groups,DC=corp,DC=local
# CA certificate that signed the domain controllers' LDAPS certificates
NETOPS_LDAP_CA_FILE=/etc/netops/corp-root-ca.pem

# --- Break-glass local admin (works when AD is down) ------------------------
# Generate with:  python -m app.cli hash-password
NETOPS_LOCAL_ADMIN_USER=admin
NETOPS_LOCAL_ADMIN_PASSWORD_HASH=

# --- Backup engine -----------------------------------------------------------
NETOPS_BACKUP_WORKERS=10
NETOPS_DEFAULT_FREQUENCY_MINUTES=1440
NETOPS_FAILURE_RETRY_MINUTES=60
NETOPS_SSH_TIMEOUT=30
NETOPS_COMMAND_TIMEOUT=180
NETOPS_HISTORY_RETENTION_DAYS=90
# Configs contain password hashes/keys; by default only admins can read them.
NETOPS_VIEWERS_CAN_READ_CONFIGS=false

# --- Firmware tool -----------------------------------------------------------
# How often each device's software version is re-read (minutes)
NETOPS_FIRMWARE_CHECK_MINUTES=1440
NETOPS_FIRMWARE_WORKERS=5
# Largest image upload accepted (MB)
NETOPS_FIRMWARE_MAX_UPLOAD_MB=4096

# --- Upgrade jobs ------------------------------------------------------------
# Jobs that can run checks at the same time (one per device)
NETOPS_UPGRADE_WORKERS=2
# Pre-check warnings (not blockers) above these CPU and memory percentages
NETOPS_UPGRADE_CPU_WARN=80
NETOPS_UPGRADE_MEM_WARN=85
# Free flash needed = image size x factor (IOS-XE install mode unpacks the image)
NETOPS_UPGRADE_FLASH_FACTOR=1.1
NETOPS_UPGRADE_FLASH_FACTOR_INSTALL=2.2
# A config backup older than this is taken again before an upgrade
NETOPS_UPGRADE_BACKUP_MAX_AGE_HOURS=24
# Platforms allowed to run LIVE upgrades, comma-separated (or platform:path, e.g.
# cisco_ftd:fdm_ha). Empty = every job is a dry run. Add a platform only after it has
# passed docs/upgrade-lab-tests.md. Platforms: cisco_ios, cisco_nxos, cisco_asa,
# cisco_ftd, allied_awplus
NETOPS_UPGRADE_LIVE_PLATFORMS=
# IOS-XE: the switch reverts by itself unless the new version is committed in time
NETOPS_UPGRADE_ABORT_TIMER_MIN=120
# How long to wait for a device to reload and come back (FTD gets 3x this)
NETOPS_UPGRADE_RELOAD_TIMEOUT_MIN=30
# Wait after a device is back before running the post-checks
NETOPS_UPGRADE_SETTLE_SECONDS=120
# Image copy and install commands
NETOPS_UPGRADE_COPY_TIMEOUT_MIN=60
